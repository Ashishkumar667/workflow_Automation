        "express-validator": "^7.0.1",
        "@grpc/grpc-js": "^1.9.14",
        "@grpc/proto-loader": "^0.7.10"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/node": "^20.10.0",
        "typescript": "^5.3.0",
        "ts-node-dev": "^2.0.0"
    }
