{
    "name": "ai-service",
    "version": "1.0.0",
    "description": "Mock AI service with gRPC",
    "main": "dist/server.js",
    "scripts": {
        "proto:compile": "echo 'Using proto-loader at runtime'",
        "build": "tsc",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "start": "node dist/server.js"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.9.14",
        "@grpc/proto-loader": "^0.7.10",
        "dotenv": "^16.3.1"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "typescript": "^5.3.0",
        "ts-node-dev": "^2.0.0"
    }
}