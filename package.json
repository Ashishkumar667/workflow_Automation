{
  "name": "ai-workflow-engine",
  "version": "1.0.0",
  "description": "AI Workflow Automation Engine - Microservices Architecture",
  "private": true,
  "workspaces": [
    "services/auth-service",
    "services/workflow-service",
    "services/execution-service",
    "services/ai-service",
    "services/webhook-service"
  ],
  "scripts": {
    "proto:compile": "npm run proto:compile --workspaces",
    "build": "npm run build --workspaces",
    "dev:auth": "npm run dev -w services/auth-service",
    "dev:workflow": "npm run dev -w services/workflow-service",
    "dev:execution": "npm run dev -w services/execution-service",
    "dev:ai": "npm run dev -w services/ai-service",
    "dev:webhook": "npm run dev -w services/webhook-service",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "ai",
    "workflow",
    "automation",
    "microservices",
    "grpc",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  }
}
